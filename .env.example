# OmniTrade AI Matrix Configuration

# Trading Mode: 'paper' (zero-risk simulation with $10,000) or 'live'
TRADING_MODE=paper
INITIAL_PAPER_BALANCE=10000.0

# Risk Management
MAX_RISK_PER_TRADE_PCT=1.5
MAX_DAILY_DRAWDOWN_PCT=3.0
AI_CONSENSUS_THRESHOLD=0.75

# Local GPU AI Models (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
QWEN_MODEL=qwen2.5-coder:32b
DEEPSEEK_MODEL=deepseek-coder-v2:16b
FAST_CHAT_MODEL=qwen3:latest
HERMES_MODEL=hermes3:8b

# Exchange API Keys (Optional for live mode)
DEFAULT_EXCHANGE=binance
BINANCE_API_KEY=
BINANCE_SECRET=
BYBIT_API_KEY=
BYBIT_SECRET=

# Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_ENABLED=false
ALERT_PHONE=

# Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8888
